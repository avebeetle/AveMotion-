+void LOTPaintDataItem::updateAveSourceGeometry()
+{
+    const auto *paintGroup = static_cast<const LOTContentGroupItem *>(parent());
+    if (!paintGroup || mPathItems.empty()) return;
+
+    bool invertible = false;
+    const VMatrix inversePaint = paintGroup->matrix().inverted(&invertible);
+    if (!invertible) return;
+
+    VPath localPath;
+    bool geometryStatic = true;
+    for (const auto *pathItem : mPathItems) {
+        if (!pathItem) return;
+        VPath path;
+        path.clone(pathItem->localPath());
+        const VMatrix relative = pathItem->sourceMatrix() * inversePaint;
+        path.transform(relative);
+        localPath.addPath(path);
+        geometryStatic &= pathItem->sourceGeometryStaticFor(paintGroup);
+    }
+    mDrawable.setAveLocalGeometry(
+        localPath,
+        paintGroup->matrix(),
+        geometryStatic);
+}
